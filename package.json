{
	"name": "mica",
	"version": "0.2.0",
	"description": "Versioned, structured content blocks for Obsidian — fast nested tabs and grids with first-class version history and Meld-class diffing.",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=11.3.0 <12"
	},
	"scripts": {
		"wasm": "wasm-pack build crates/mica-core --target web --release --out-dir ../../src/wasm/pkg -- --locked && rm -f src/wasm/pkg/mica_core_bg.wasm.d.ts",
		"smoke": "node tests/smoke.mjs",
		"e2e": "wdio run wdio.conf.mts",
		"e2e:minimum": "MICA_E2E_PROFILE=minimum wdio run wdio.conf.mts",
		"e2e:mobile": "MICA_E2E_PROFILE=mobile wdio run wdio.conf.mts",
		"e2e:latest": "MICA_E2E_PROFILE=desktop-latest wdio run wdio.conf.mts",
		"build": "pnpm run wasm && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:rust": "cargo test --workspace --locked",
		"test:sidecar-fallback": "node tests/sidecar-fallback.mjs",
		"test:ledger-contracts": "tsx tests/ledger-contracts.mts",
		"test:diff-budget": "tsx tests/diff-budget.mts",
		"test:version-window": "tsx tests/version-window.mts",
		"test:copy-payload": "tsx tests/copy-payload.mts",
		"test:block-label": "tsx tests/block-label.mts",
		"test:code-fence": "tsx tests/code-fence.mts",
		"test:nested-sections": "tsx tests/nested-sections.mts",
		"test:section-format": "tsx tests/section-format.mts",
		"check:release": "node tests/release-metadata.mjs",
		"check:release:assets": "node tests/release-metadata.mjs --artifacts",
		"check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test:sidecar-fallback && pnpm run test:ledger-contracts && pnpm run test:diff-budget && pnpm run test:version-window && pnpm run test:copy-payload && pnpm run test:block-label && pnpm run test:code-fence && pnpm run test:nested-sections && pnpm run test:section-format && pnpm run test:rust && pnpm run check:release"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tabs",
		"versioning",
		"diff"
	],
	"author": "DevGuyRash",
	"license": "MIT",
	"dependencies": {
		"fflate": "0.8.3"
	},
	"devDependencies": {
		"@codemirror/commands": "6.9.0",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "latest",
		"@codemirror/legacy-modes": "^6.5.3",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@lezer/highlight": "^1.2.3",
		"@lezer/markdown": "^1.7.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "latest",
		"@wdio/cli": "^9.29.1",
		"@wdio/globals": "^9.29.1",
		"@wdio/local-runner": "^9.29.1",
		"@wdio/mocha-framework": "^9.29.1",
		"builtin-modules": "^5.0.0",
		"esbuild": "latest",
		"eslint": "latest",
		"mocha": "^11.7.6",
		"obsidian": "latest",
		"prettier": "latest",
		"tsx": "^4.23.0",
		"typescript": "~5.9.0",
		"typescript-eslint": "latest",
		"wdio-obsidian-reporter": "^3.1.1",
		"wdio-obsidian-service": "^3.1.1"
	}
}
