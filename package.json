{
	"name": "mica",
	"version": "0.3.0",
	"description": "Versioned, structured content blocks for Obsidian \u2014 fast nested tabs and grids with first-class version history and Meld-class diffing.",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=11.3.0 <12"
	},
	"scripts": {
		"wasm": "node esbuild.config.mjs wasm && rm -f src/wasm/pkg/mica_core_bg.wasm.d.ts",
		"smoke": "node tests/smoke.mjs",
		"e2e": "node scripts/e2e.mjs",
		"e2e:minimum": "MICA_E2E_PROFILE=minimum node scripts/e2e.mjs",
		"e2e:mobile": "MICA_E2E_PROFILE=mobile node scripts/e2e.mjs",
		"e2e:latest": "MICA_E2E_PROFILE=desktop-latest node scripts/e2e.mjs",
		"build": "pnpm run wasm && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"audit:prod": "pnpm audit --prod --audit-level high",
		"test:rust": "cargo test --workspace --locked",
		"test:sidecar-fallback": "node tests/sidecar-fallback.mjs",
		"test:ledger-contracts": "tsx tests/ledger-contracts.mts",
		"test:diff-budget": "tsx tests/diff-budget.mts",
		"test:version-window": "tsx tests/version-window.mts",
		"test:version-base": "tsx tests/version-base.mts",
		"test:version-lineage": "tsx tests/version-lineage.mts",
		"test:copy-payload": "tsx tests/copy-payload.mts",
		"test:dock-config": "tsx tests/dock-config.mts",
		"test:text-stats": "tsx tests/text-stats.mts",
		"test:version-scope": "tsx tests/version-scope.mts",
		"test:version-transition": "tsx tests/version-transition.mts",
		"test:scope-selection": "tsx tests/scope-selection.mts",
		"test:scope-display": "tsx tests/scope-display.mts",
		"test:comparison-plan": "tsx tests/comparison-plan.mts",
		"test:version-generated": "tsx tests/version-transition-generated.mts --seeds=250",
		"test:version-stress": "tsx tests/version-transition-generated.mts --seeds=2000",
		"test:upgrade-performance": "tsx tests/upgrade-performance.mts",
		"test:search-worker": "tsx tests/search-worker.mts",
		"test:responsive-actions": "tsx tests/responsive-actions.mts",
		"test:section-action-prefs": "tsx tests/section-action-prefs.mts",
		"test:toolbar-layout": "tsx tests/toolbar-layout.mts",
		"test:custom-tool-config": "tsx tests/custom-tool-config.mts",
		"test:block-label": "tsx tests/block-label.mts",
		"test:code-fence": "tsx tests/code-fence.mts",
		"test:nested-sections": "tsx tests/nested-sections.mts",
		"test:section-format": "tsx tests/section-format.mts",
		"test:markdown-literal": "tsx tests/markdown-literal.mts",
		"check:release": "node tests/release-metadata.mjs",
		"check:release:assets": "node tests/release-metadata.mjs --artifacts",
		"check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test:sidecar-fallback && pnpm run test:ledger-contracts && pnpm run test:diff-budget && pnpm run test:hide-syntax && pnpm run test:combine-kind && pnpm run test:icon-packs && pnpm run test:version-window && pnpm run test:version-timeline && pnpm run test:version-base && pnpm run test:version-lineage && pnpm run test:copy-payload && pnpm run test:dock-config && pnpm run test:text-stats && pnpm run test:version-scope && pnpm run test:version-transition && pnpm run test:scope-selection && pnpm run test:scope-display && pnpm run test:comparison-plan && pnpm run test:version-generated && pnpm run test:upgrade-performance && pnpm run test:search-worker && pnpm run test:responsive-actions && pnpm run test:section-action-prefs && pnpm run test:toolbar-layout && pnpm run test:custom-tool-config && pnpm run test:block-label && pnpm run test:code-fence && pnpm run test:nested-sections && pnpm run test:section-format && pnpm run test:markdown-literal && pnpm run test:rust && pnpm run check:release",
		"test:version-timeline": "tsx tests/version-timeline.mts",
		"test:hide-syntax": "tsx tests/hide-syntax.mts",
		"test:icon-packs": "tsx tests/icon-packs.mts",
		"test:combine-kind": "tsx tests/combine-kind.mts"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tabs",
		"versioning",
		"diff"
	],
	"author": "DevGuyRash",
	"license": "MIT",
	"dependencies": {
		"fflate": "0.8.3"
	},
	"devDependencies": {
		"@codemirror/commands": "6.9.0",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "latest",
		"@codemirror/legacy-modes": "^6.5.3",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@lezer/highlight": "^1.2.3",
		"@lezer/markdown": "^1.7.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "latest",
		"@wdio/cli": "^9.29.1",
		"@wdio/globals": "^9.29.1",
		"@wdio/local-runner": "^9.29.1",
		"@wdio/mocha-framework": "^9.29.1",
		"esbuild": "latest",
		"eslint": "latest",
		"mocha": "^11.7.6",
		"obsidian": "latest",
		"prettier": "latest",
		"tsx": "^4.23.0",
		"typescript": "~5.9.0",
		"typescript-eslint": "latest",
		"wdio-obsidian-reporter": "^3.1.1",
		"wdio-obsidian-service": "^3.1.1"
	}
}
